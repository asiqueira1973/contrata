# Variáveis da seção 18 do spec. Copie para .env.local e preencha. Nenhum valor real neste arquivo.

# Origem pública do site (OAuth, links, JSON-LD, metadados MCP). Produção: https://vagaaberta.app.br
NEXT_PUBLIC_SITE_URL=http://localhost:3050
# Nome exibido (pergunta 25.1, respondida: Vaga Aberta)
NEXT_PUBLIC_NOME_PRODUTO="Vaga Aberta"

# Banco (Supabase). Local: `supabase status` mostra a URL e a service role.
SUPABASE_URL=http://127.0.0.1:55721
SUPABASE_SERVICE_ROLE_KEY=

# Login Google (obrigatório). Redirect: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT das sessões e HMAC dos códigos do candidato (32+ bytes aleatórios: openssl rand -base64 32)
SESSION_SECRET=

# Fallback com prévia do MCP (13.5): HMAC do token_previa (32+ bytes aleatórios)
MCP_PREVIEW_SECRET=
# Assina o link de pré-visualização da página de carreiras não publicada (8.3). openssl rand -base64 32
PREVIA_PAGINA_SECRET=
# Deriva o link de acompanhamento do candidato /c/{token} (8.6; 11.4): HMAC de candidatura + versão. openssl rand -base64 32
# Trocar o valor invalida todos os links já enviados.
LINK_CANDIDATO_SECRET=
# Armazenamento dos currículos (8.4): qualquer S3, R2 por padrão (bucket privado com CORS para o
# site). R2: S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com e S3_REGION=auto. Vazias, em
# desenvolvimento, os arquivos vão para .armazenamento-local/.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Protege /api/cron/diario (faxina, 11.11). A Vercel manda Authorization: Bearer <CRON_SECRET>. openssl rand -base64 32
CRON_SECRET=

# Regra 11.33: e-mails ou @dominio que podem criar empresa, separados por vírgula. Vazia = ninguém cria.
CRIACAO_EMPRESA_EMAILS=
# E-mails que não entram no painel
EMAILS_BLOQUEADOS=
# Alertas da instância
ADMIN_EMAIL=

# E-mail (Resend). Sem RESEND_API_KEY, os e-mails vão para .caixa-de-saida-local/ (só em dev).
RESEND_API_KEY=
# Produção: naoresponda@vagaaberta.app.br (domínio verificado no Resend, 27.6)
EMAIL_REMETENTE=

# Cifra AES-256-GCM do segredo dos webhooks (8.8, 11.17): 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVES_ENC_KEY=

# A partir dos próximos épicos:
# VISAO_INGEST_URL= VISAO_API_KEY=   (8.11, opcional)
