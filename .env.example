# Variáveis da seção 18 do spec. Copie para .env.local e preencha. Nenhum valor real neste arquivo.

# Origem pública do site (OAuth, links, JSON-LD, metadados MCP)
NEXT_PUBLIC_SITE_URL=http://localhost:3050
# Nome exibido (pergunta 25.1)
NEXT_PUBLIC_NOME_PRODUTO=Contrata

# Banco (Supabase). Local: `supabase status` mostra a URL e a service role.
SUPABASE_URL=http://127.0.0.1:55721
SUPABASE_SERVICE_ROLE_KEY=

# Login Google (obrigatório). Redirect: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT das sessões e HMAC dos códigos do candidato (32+ bytes aleatórios: openssl rand -base64 32)
SESSION_SECRET=

# Regra 11.33: e-mails ou @dominio que podem criar empresa, separados por vírgula. Vazia = ninguém cria.
CRIACAO_EMPRESA_EMAILS=
# E-mails que não entram no painel
EMAILS_BLOQUEADOS=
# Alertas da instância
ADMIN_EMAIL=

# E-mail (Resend). Sem RESEND_API_KEY, os e-mails vão para .caixa-de-saida-local/ (só em dev).
RESEND_API_KEY=
EMAIL_REMETENTE=

# A partir dos próximos épicos:
# S3_ENDPOINT= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_BUCKET=   (8.4)
# CHAVES_ENC_KEY=   (8.8, webhooks)
# CRON_SECRET=      (8.10)
# VISAO_INGEST_URL= VISAO_API_KEY=   (8.11, opcional)
