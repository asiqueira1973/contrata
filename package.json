{
  "name": "contrata",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "next build",
    "start": "next start --port 3050",
    "typecheck": "npm run build:ui && next typegen && tsc --noEmit",
    "lint": "eslint",
    "test:guardrails": "./scripts/test-guardrails.sh && ./scripts/check-guardrails-diff.sh",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "npm run build:ui && vitest run --passWithNoTests",
    "test": "npm run test:guardrails && npm run test:db && npm run test:unit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:schema": "node scripts/gen-schema.mjs",
    "build:ui": "tsx scripts/build-ui.mts",
    "predev": "npm run build:ui",
    "prebuild": "npm run build:ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
