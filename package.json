{
  "name": "contrata",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3050",
    "build": "next build",
    "start": "next start --port 3050",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test:guardrails": "./scripts/test-guardrails.sh && ./scripts/check-guardrails-diff.sh",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "vitest run --passWithNoTests",
    "test": "npm run test:guardrails && npm run test:db && npm run test:unit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:schema": "node scripts/gen-schema.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
